<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Settings"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <!-- YOUTUBE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="YouTube"
            android:textColor="#FFD600"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/connectYouTubeButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="▶ Connect YouTube Account"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/signOutYouTubeButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="🚪 Sign Out of YouTube"
            android:textAllCaps="false"/>

        <!-- LOGGER — SETTINGS ONLY -->

        <Button
            android:id="@+id/settingsLogButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="🍋 Open Live Debug Logger"
            android:textAllCaps="false"/>

        <!-- ABOUT -->

        <Button
            android:id="@+id/aboutButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="🍋 About Lemon Music"
            android:textAllCaps="false"/>

    </LinearLayout>

</ScrollView>