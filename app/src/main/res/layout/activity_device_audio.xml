<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101010">


    <!-- ========================================= -->
    <!-- TOP BAR -->
    <!-- ========================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/deviceAudioBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="📁 Device Audio"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/deviceRefreshButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Refresh"/>

    </LinearLayout>


    <!-- ========================================= -->
    <!-- EMPTY STATE -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/deviceEmptyText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="30dp"
        android:text="No music found on this device.&#10;&#10;Add some music and tap Refresh."
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:visibility="gone"/>


    <!-- ========================================= -->
    <!-- SONG LIST -->
    <!-- ========================================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/deviceSongsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp"/>

</LinearLayout>