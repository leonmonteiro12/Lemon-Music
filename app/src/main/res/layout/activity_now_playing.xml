
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0B08"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FFD928" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="NOW PLAYING"
            android:textColor="#FFF9D6"
            android:textSize="17sp"
            android:letterSpacing="0.08"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/buttonMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="More options"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_more"
            android:tint="#FFD928" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="15dp"
        android:background="#181810">

        <ImageView
            android:id="@+id/albumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Current video thumbnail"
            android:scaleType="centerInside"
            android:src="@drawable/lemon_music_icon" />

        <ProgressBar
            android:id="@+id/loadingProgress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFD928"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/buttonCenterPlay"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:background="@drawable/lemon_player_play_bg"
            android:contentDescription="Play or pause"
            android:padding="17dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="#171707" />
    </FrameLayout>

    <TextView
        android:id="@+id/songTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Nothing playing"
        android:textColor="#FFFDF0"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/songArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Unknown artist"
        android:textColor="#BDBBAA"
        android:textSize="15sp" />

    <Button
        android:id="@+id/lyricsButton"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="🎤  Lyrics"
        android:textAllCaps="false"
        android:textColor="#171707"
        android:textStyle="bold"
        android:backgroundTint="#FFD928" />

    <SeekBar
        android:id="@+id/playerSeekBar"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FFD928"
        android:progressBackgroundTint="#555548"
        android:thumbTint="#FFE66B" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/currentTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="#BDBBAA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/totalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#BDBBAA"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/buttonPrevious"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous track"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFE66B" />

        <ImageButton
            android:id="@+id/buttonRewind"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Rewind"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_rew"
            android:tint="#FFE66B" />

        <ImageButton
            android:id="@+id/buttonPlayPause"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/lemon_player_play_bg"
            android:contentDescription="Play or pause"
            android:padding="15dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="#171707" />

        <ImageButton
            android:id="@+id/buttonForward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_ff"
            android:tint="#FFE66B" />

        <ImageButton
            android:id="@+id/buttonNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next track"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFE66B" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/buttonQueue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="QUEUE"
            android:textColor="#FFD928"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/buttonPlaylist"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="PLAYLIST"
            android:textColor="#FFD928"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/buttonFloating"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="FLOAT"
            android:textColor="#FFD928"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
</LinearLayout>
