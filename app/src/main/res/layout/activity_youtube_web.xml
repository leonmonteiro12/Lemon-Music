<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080808"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FFFFFF"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Now Playing"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/buttonMore"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:contentDescription="More options"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_more"
            android:tint="#FFFFFF"/>

    </LinearLayout>


    <!-- =====================================================
         MAIN PLAYER AREA
         ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- LARGE ARTWORK AREA -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#202020"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp">

            <ProgressBar
                android:id="@+id/loadingProgress"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:visibility="gone"/>

            <ImageButton
                android:id="@+id/buttonCenterPlay"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:contentDescription="Play"
                android:padding="18dp"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FFFFFF"/>

        </FrameLayout>


        <!-- SONG TITLE -->

        <TextView
            android:id="@+id/songTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:text="YouTube Music"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"/>


        <!-- ARTIST -->

        <TextView
            android:id="@+id/songArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:text="YouTube"
            android:textColor="#AAAAAA"
            android:textSize="16sp"/>

    </LinearLayout>


    <!-- =====================================================
         LYRICS BUTTON
         ===================================================== -->
<Button
    android:id="@+id/lyricsButton"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:layout_gravity="start"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:minWidth="0dp"
    android:minHeight="0dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:text="🎤 Lyrics"
    android:textAllCaps="false"
    android:textColor="#151515"
    android:textSize="14sp"
    android:backgroundTint="#C9B5FF"/>
    <!-- =====================================================
         SEEK BAR
         ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <SeekBar
            android:id="@+id/playerSeekBar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:max="100"
            android:progress="0"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/currentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/totalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

        </LinearLayout>

    </LinearLayout>


    <!-- =====================================================
         PLAYBACK CONTROLS
         ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- PREVIOUS -->

        <ImageButton
            android:id="@+id/buttonPrevious"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="Previous"
            android:padding="13dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF"/>


        <!-- REWIND -->

        <ImageButton
            android:id="@+id/buttonRewind"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@android:color/transparent"
            android:contentDescription="Rewind"
            android:padding="13dp"
            android:src="@android:drawable/ic_media_rew"
            android:tint="#FFFFFF"/>


        <!-- PLAY / PAUSE -->

        <ImageButton
            android:id="@+id/buttonPlayPause"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="Play or pause"
            android:padding="15dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FFFFFF"/>


        <!-- FORWARD -->

        <ImageButton
            android:id="@+id/buttonForward"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@android:color/transparent"
            android:contentDescription="Forward"
            android:padding="13dp"
            android:src="@android:drawable/ic_media_ff"
            android:tint="#FFFFFF"/>


        <!-- NEXT -->

        <ImageButton
            android:id="@+id/buttonNext"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="Next"
            android:padding="13dp"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFFFFF"/>

    </LinearLayout>


    <!-- =====================================================
         LOWER ACTIONS
         ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/buttonQueue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="QUEUE"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/buttonPlaylist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="PLAYLIST"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/buttonFloating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="FLOAT"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>